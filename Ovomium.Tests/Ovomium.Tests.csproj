<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de la logique pure du mod (sans Unity ni Valheim), exécutés par le build de la solution : le build
       échoue si un test échoue. Cible net8.0 (le SDK du conteneur) et non net48, qui ne s'exécute pas sous Linux.
       Propriétés communes : ../Directory.Build.props -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ovomium.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Ovomium/Features/ChestFill/StackGrouping.cs" Link="ChestFill/StackGrouping.cs" />
    <Compile Include="../Ovomium/Features/PickupFilter/PickupFilterList.cs" Link="PickupFilter/PickupFilterList.cs" />
    <Compile Include="../Ovomium/Features/Updater/MiniJson.cs" Link="Updater/MiniJson.cs" />
    <Compile Include="../Ovomium/Features/Updater/ChangelogFormatter.cs" Link="Updater/ChangelogFormatter.cs" />
    <Compile Include="../Ovomium/Features/ServerWake/NodecraftLink.cs" Link="ServerWake/NodecraftLink.cs" />
    <Compile Include="../Ovomium/Features/ServerWake/NodecraftStatus.cs" Link="ServerWake/NodecraftStatus.cs" />
    <Compile Include="../Ovomium/Features/ServerWake/NodecraftHttp.cs" Link="ServerWake/NodecraftHttp.cs" />
    <Compile Include="../Ovomium/Features/ServerWake/NodecraftThrottle.cs" Link="ServerWake/NodecraftThrottle.cs" />
    <Compile Include="../Ovomium/Features/ServerWake/ServerLink.cs" Link="ServerWake/ServerLink.cs" />
  </ItemGroup>

  <Target Name="RunTests" AfterTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
