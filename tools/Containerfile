# Image de build/décompilation du mod ovomiam (aucune chaîne C# sur l'hôte).
# Construire : podman build -t ovomiam-build -f tools/Containerfile tools
FROM mcr.microsoft.com/dotnet/sdk:8.0

# Tout l'état dotnet/NuGet dans /nuget : build.sh y monte build/nuget (possédé par l'utilisateur,
# le conteneur tournant avec --userns=keep-id).
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_HOME=/nuget \
    NUGET_PACKAGES=/nuget/packages \
    NUGET_HTTP_CACHE_PATH=/nuget/http-cache \
    NUGET_PLUGINS_CACHE_PATH=/nuget/plugins-cache \
    PATH="/opt/dotnet-tools:${PATH}"

# --tool-path plutôt que -g : /root est inaccessible avec --userns=keep-id.
# Version épinglée : les ilspycmd récents ne s'installent pas sur le SDK 8.
RUN dotnet tool install ilspycmd --version 9.1.0.7988 --tool-path /opt/dotnet-tools \
    && chmod -R a+rX /opt/dotnet-tools \
    && rm -rf /nuget && mkdir -p /nuget && chmod 1777 /nuget

WORKDIR /src
