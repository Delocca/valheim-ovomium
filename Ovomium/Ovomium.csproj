<Project Sdk="Microsoft.NET.Sdk">

  <!-- Propriétés communes (net48, warnings = erreurs, ValheimManaged…) : ../Directory.Build.props -->
  <PropertyGroup>
    <AssemblyName>Ovomium</AssemblyName>
    <RootNamespace>Ovomium</RootNamespace>
    <Version>0.9.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Localization, UITooltip (UpgradeDiff) -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CanvasGroup (Hud.m_loadingScreen) et Rigidbody (Character.m_body) -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Animator / AnimatorCullingMode (FirstPerson) -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManaged)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Texture2D.LoadImage (LoadingArt) ; ce module cible netstandard 2.1, absent des assemblies de référence
         net48 : on prend la façade netstandard.dll du jeu -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManaged)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(ValheimManaged)/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Façade UnityEngine.dll : BepInEx.Core y référence MonoBehaviour (redirigé vers CoreModule) -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HttpClient et ZipFile (LoadingArt : téléchargement des artworks), versions Mono embarquées par le jeu -->
    <Reference Include="System.Net.Http">
      <HintPath>$(ValheimManaged)/System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <HintPath>$(ValheimManaged)/System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <HintPath>$(ValheimManaged)/System.IO.Compression.FileSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Seule source de vérité de la version : <Version> ci-dessus, exposée au code via PluginVersion.Value -->
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginVersionFile>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="// Généré par Ovomium.csproj (GeneratePluginVersion). Ne pas modifier.;namespace Ovomium { internal static class PluginVersion { public const string Value = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(PluginVersionFile)" />
      <FileWrites Include="$(PluginVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
